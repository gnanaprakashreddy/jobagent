# ---- LLM (any OpenAI-compatible endpoint) ----
# Default: GitHub Models, uses your `gh auth token` automatically if LLM_API_KEY is empty.
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# Ollama (free, local): ollama pull llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# ---- Optional: Adzuna (free key at https://developer.adzuna.com) for on-site jobs in India/US/UK/EU ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
